{
  "name": "vigil",
  "displayName": "VIGIL",
  "version": "0.1.0",
  "private": false,
  "description": "Persistent, observation-first cognitive agent. MCP-native, headless.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chronokairo-dotcom/vigil.git"
  },
  "homepage": "https://github.com/chronokairo-dotcom/vigil",
  "bugs": {
    "url": "https://github.com/chronokairo-dotcom/vigil/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vigil-mcp": "dist/interfaces/api/index.js",
    "vigil-api": "dist/interfaces/api/start-api.js",
    "vigil": "dist/interfaces/cli/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start:api": "node dist/interfaces/api/start-api.js",
    "start:mcp": "node dist/interfaces/api/index.js",
    "start:cli": "node dist/interfaces/cli/index.js",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "test:readme": "vitest run src/__tests__/readme-concepts.test.ts",
    "typecheck": "tsc --noEmit",
    "ci:install": "pnpm install --frozen-lockfile",
    "docker:build": "docker build -f Dockerfile -t vigil:local .",
    "docker:build:cli": "docker build -f Dockerfile.cli -t vigil-cli:local ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "adm-zip": "^0.5.17",
    "axios": "^1.15.2",
    "chokidar": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "commander": "^12.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "hono": "^4.12.15",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "node-pty": "^1.1.0",
    "pdf-parse": "^1.1.4",
    "reflect-metadata": "^0.1.13",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.28",
    "uuid": "^14.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.19.39",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.7.0",
    "typescript": "^5.1.6",
    "vitest": "^4.1.5"
  },
  "onlyBuiltDependencies": [
    "sqlite3"
  ],
  "keywords": [
    "ai",
    "agent",
    "memory",
    "mcp",
    "model-context-protocol",
    "observation",
    "cli",
    "headless"
  ],
  "author": "VIGIL Contributors",
  "license": "MIT"
}
