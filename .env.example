# ─── Feature flags ────────────────────────────────────────────────
# Master switch for any LLM usage. Set to 0 to disable all LLM calls.
VIGIL_FEATURE_LLM=1
# Hard-disable LLM calls regardless of provider keys (overrides VIGIL_FEATURE_LLM).
VIGIL_LLM_DISABLED=0

# ─── Runtime ──────────────────────────────────────────────────────
# Root directory for runtime persistence (logs, indexes, summaries).
VIGIL_DATA_DIR=./data
# Log level: debug | info | warn | error
VIGIL_LOG_LEVEL=info

# ─── HTTP / MCP server ────────────────────────────────────────────
VIGIL_API_HOST=127.0.0.1
VIGIL_API_PORT=11434
# JWT secret for the HTTP API. Generate with `openssl rand -hex 32`.
VIGIL_JWT_SECRET=

# ─── Observation ──────────────────────────────────────────────────
# Comma-separated paths the file-watcher observer is allowed to watch.
VIGIL_OBSERVE_PATHS=
# Sleep-cycle interval in minutes (0 disables).
VIGIL_SLEEP_INTERVAL_MINUTES=720

# ─── LLM providers (set the ones you use) ─────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Ollama-compatible local endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434
